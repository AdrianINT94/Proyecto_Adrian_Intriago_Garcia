<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="378.0" prefWidth="162.0" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hito5.proyecto.controller.AlumnoFormController">
		
		
		<Label text="Alumno" />
		
		<TextField fx:id="txtNombre" promptText="Nombre" />
		<TextField fx:id="txtEmail" promptText="Email" />
		<TextField fx:id="txtCiclo" promptText="Ciclo" />
		<TextField fx:id="txtCurso" promptText="Curso" />
   <ComboBox fx:id="comboEmpresa" prefWidth="150.0" promptText="AdjudicarEmpresa" />
   <ComboBox fx:id="comboTutor" prefWidth="150.0" promptText="TutorEmpresa" />
   <ComboBox fx:id="comboProfesor" prefWidth="150.0" promptText="Profesor" />
   <DatePicker fx:id="dpInicio" />
   <DatePicker fx:id="dpFin" />
		
		<HBox spacing="10">
			<Button onAction="#guardar" text="Guardar" />
			<Button onAction="#cancelar" text="Cancelar" />
			
		</HBox>
		
</VBox>
