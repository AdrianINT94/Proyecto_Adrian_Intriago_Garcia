<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hito5.proyecto.controller.AlumnosViewController">

    <Label style="-fx-font-size: 18px" text="Gestión de Alumnos" />

    <TableView fx:id="tablaAlumnos">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre" />
            <TableColumn fx:id="colEmail" text="Email" />
            <TableColumn fx:id="colCiclo" text="Ciclo" />
            <TableColumn fx:id="colCurso" text="Curso" />
        </columns>
    </TableView>


	<HBox alignment="CENTER" spacing="10">
			<Button onAction="#nuevoAlumno" text="Añadir" />
			<Button onAction="#editarAlumno" text="Editar" />
			<Button onAction="#eliminarAlumno" text="Eliminar" />
			<Button onAction="#volver" text="Volver" />
			
	</HBox>
</VBox>
