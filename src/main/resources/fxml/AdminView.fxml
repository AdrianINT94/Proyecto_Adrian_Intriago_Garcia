<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hito5.proyecto.controller.AdminController">
			<top>
				<Label style="-fx-font-size: 18px; -fx-padding:10;" text="Gestion de Alumnos" BorderPane.alignment="CENTER" />
			</top>
			
			<center>
			<TableView fx:id="tablaAlumnos">
				<columns>
					<TableColumn fx:id="colNombre" prefWidth="90.4000244140625" text="Nombre" />
					<TableColumn fx:id="colEmail" prefWidth="104.0" text="Email" />
					<TableColumn fx:id="colCiclo" prefWidth="121.60003662109375" text="Ciclo" />
					<TableColumn fx:id="colCurso" prefWidth="102.4000244140625" text="Curso" />
            <TableColumn fx:id="colEmpresa" prefWidth="190.39999389648438" text="Empresa" />
            <TableColumn fx:id="colTutor" prefWidth="75.0" text="Tutor" />
            <TableColumn fx:id="colProfesor" prefWidth="75.0" text="Profesor" />
					
				</columns>
			</TableView>
		</center>
			
		<bottom>
			<HBox alignment="CENTER" spacing="10" style="-fx-padding:10;">
				<Button onAction="#nuevoAlumno" text="Nuevo" />
				<Button onAction="#editarAlumno" text="Editar" />
				<Button onAction="#eliminarAlumno" text="Eliminar" />
				<Button onAction="#exportarCSV" text="Exportar CSV" />
         <Button mnemonicParsing="false" onAction="#irEmpresas" text="GestionEmpresas" />
				<Button onAction="#volver" text="Volver" />
				
			</HBox>
		</bottom>
			
			
			
</BorderPane>
